  likes     CommunityPostLike[]
  comments  CommunityPostComment[]

  @@index([communityId])
  @@index([userId])
  @@map("community_posts")
}

model CommunityPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_post_likes")
}

model CommunityPostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("community_post_comments")
}

enum CommunityRole {
  ADMIN      // Full control
  MODERATOR  // Can moderate content
  MEMBER     // Regular member
}

// ================================
// CHALLENGES BETWEEN FRIENDS
// ================================

model FriendChallenge {
  id          String          @id @default(cuid())
  creatorId   String
  title       String
  description String
  type        FriendChallengeType
  goal        Int             // Target to reach
  metric      String          // What to measure (reps, time, sessions, etc.)

  startDate DateTime
  endDate   DateTime

  isPublic Boolean @default(false) // Visible to other friends
  status   ChallengeStatus @default(ACTIVE)

  // Rewards
