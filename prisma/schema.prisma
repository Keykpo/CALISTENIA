enum FriendChallengeType {
  EXERCISE_COUNT    // Complete N reps of an exercise
  WORKOUT_SESSIONS  // Complete N workout sessions
  TIME_BASED        // Hold position for N seconds total
  DISTANCE          // Run/cycle N km
  STREAK            // Maintain streak for N days
