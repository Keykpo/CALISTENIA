// ================================
// SOCIAL FEATURES SYSTEM
// Complete social network features for fitness community
// ================================

// ================================
// POSTS & FEED SYSTEM
// ================================

model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String // Post text content
  images    String? // JSON array of image URLs
  videoUrl  String? // Single video URL
  type      PostType @default(GENERAL)

  // Workout sharing
  workoutId String? // Reference to shared workout
  achievement String? // JSON data for shared achievement

  // Engagement metrics
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)

  // Visibility
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]
  shares   PostShare[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  parentId  String? // For nested comments/replies

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@map("post_comments")
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  caption   String? // Optional caption when sharing
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_shares")
}

enum PostType {
  GENERAL          // General post
  WORKOUT_SHARE    // Sharing a workout
  PROGRESS_UPDATE  // Progress photo/update
  ACHIEVEMENT      // Achievement share
  QUESTION         // Asking for help
  TIP              // Sharing tips
  MOTIVATION       // Motivational post
  CHALLENGE        // Challenge announcement
}

// ================================
// FRIENDS & FOLLOWERS SYSTEM
// ================================

model Friendship {
  id         String           @id @default(cuid())
  requesterId String          // User who sent the request
  addresseeId String          // User who received the request
  status     FriendshipStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING  // Request sent, awaiting response
  ACCEPTED // Friends
  BLOCKED  // User blocked
}

// ================================
// NOTIFICATIONS SYSTEM
// ================================

model Notification {
  id         String           @id @default(cuid())
  userId     String           // Recipient
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)

  // Reference data
  actorId    String? // User who triggered the notification
  postId     String? // Related post
  commentId  String? // Related comment
  challengeId String? // Related challenge

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  FRIEND_REQUEST      // Someone sent you a friend request
  FRIEND_ACCEPTED     // Someone accepted your friend request
  POST_LIKE           // Someone liked your post
  POST_COMMENT        // Someone commented on your post
  COMMENT_REPLY       // Someone replied to your comment
  POST_SHARE          // Someone shared your post
  CHALLENGE_INVITE    // Invited to a challenge
  CHALLENGE_COMPLETED // Friend completed a challenge
  WORKOUT_MILESTONE   // Friend reached a milestone
  ACHIEVEMENT_EARNED  // Friend earned an achievement
  MESSAGE_RECEIVED    // New direct message
  GROUP_INVITE        // Invited to a group
  MENTION             // Mentioned in a post/comment
}

// ================================
// DIRECT MESSAGES SYSTEM
// ================================

model Conversation {
  id            String   @id @default(cuid())
  participant1Id String
  participant2Id String
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant1 User            @relation("ConversationsAsParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User            @relation("ConversationsAsParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     DirectMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("conversations")
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("direct_messages")
}

// ================================
// COMMUNITIES/GROUPS SYSTEM
// ================================

model Community {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  coverImage  String?

  creatorId String
  isPublic  Boolean @default(true)

  // Stats
  membersCount Int @default(0)
  postsCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  posts   CommunityPost[]

  @@index([creatorId])
  @@index([isPublic])
  @@map("communities")
}

model CommunityMember {
  id          String         @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole  @default(MEMBER)
  joinedAt    DateTime       @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@map("community_members")
}

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  title       String
  content     String
  images      String? // JSON array

  likesCount    Int @default(0)
  commentsCount Int @default(0)

  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommunityPostLike[]
  comments  CommunityPostComment[]

  @@index([communityId])
  @@index([userId])
  @@map("community_posts")
}

model CommunityPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_post_likes")
}

model CommunityPostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("community_post_comments")
}

enum CommunityRole {
  ADMIN      // Full control
  MODERATOR  // Can moderate content
  MEMBER     // Regular member
}

// ================================
// CHALLENGES BETWEEN FRIENDS
// ================================

model FriendChallenge {
  id          String          @id @default(cuid())
  creatorId   String
  title       String
  description String
  type        FriendChallengeType
  goal        Int             // Target to reach
  metric      String          // What to measure (reps, time, sessions, etc.)

  startDate DateTime
  endDate   DateTime

  isPublic Boolean @default(false) // Visible to other friends
  status   ChallengeStatus @default(ACTIVE)

  // Rewards
  xpReward    Int @default(0)
  coinsReward Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([creatorId])
  @@index([status])
  @@map("friend_challenges")
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String

  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
  rank        Int?     // Final ranking

  joinedAt    DateTime @default(now())
  completedAt DateTime?

  challenge FriendChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@map("challenge_participants")
}

enum FriendChallengeType {
  EXERCISE_COUNT    // Complete N reps of an exercise
  WORKOUT_SESSIONS  // Complete N workout sessions
  TIME_BASED        // Hold position for N seconds total
  DISTANCE          // Run/cycle N km
  STREAK            // Maintain streak for N days
  CUSTOM            // Custom metric
}

enum ChallengeStatus {
  ACTIVE      // Currently active
  COMPLETED   // Finished
  CANCELLED   // Cancelled
}

// ================================
// WORKOUT SHARING & TEMPLATES
// ================================

model SharedWorkout {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  exercises   String   // JSON array
  difficulty  Difficulty

  // Social metrics
  likesCount     Int @default(0)
  savesCount     Int @default(0)
  completedCount Int @default(0)

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes SharedWorkoutLike[]
  saves SharedWorkoutSave[]

  @@index([userId])
  @@index([isPublic])
  @@map("shared_workouts")
}

model SharedWorkoutLike {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout SharedWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@map("shared_workout_likes")
}

model SharedWorkoutSave {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout SharedWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@map("shared_workout_saves")
}

// ================================
// ACTIVITY FEED & TRACKING
// ================================

model ActivityFeedItem {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  description String

  // Reference IDs
  relatedUserId    String? // Friend who did something
  relatedPostId    String? // Related post
  relatedWorkoutId String? // Related workout

  metadata String? // JSON with additional data

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_feed_items")
}

enum ActivityType {
  FRIEND_WORKOUT       // Friend completed a workout
  FRIEND_ACHIEVEMENT   // Friend earned an achievement
  FRIEND_MILESTONE     // Friend reached a milestone
  FRIEND_POST          // Friend created a post
  FRIEND_JOINED        // New friend joined
  CHALLENGE_UPDATE     // Challenge progress update
  COMMUNITY_POST       // Community activity
  TRENDING_WORKOUT     // Trending workout in network
}

// ================================
// USER STATS & LEADERBOARDS
// ================================

model UserStats {
  id     String @id @default(cuid())
  userId String @unique

  // Social stats
  friendsCount   Int @default(0)
  followersCount Int @default(0)
  postsCount     Int @default(0)
  likesReceived  Int @default(0)

  // Workout stats
  totalWorkouts       Int @default(0)
  currentStreak       Int @default(0)
  longestStreak       Int @default(0)
  totalWorkoutMinutes Int @default(0)

  // Rankings
  globalRank  Int? // Global ranking
  friendRank  Int? // Ranking among friends

  lastUpdated DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}
